#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! getent passwd bench-parts >/dev/null; then
        useradd --system --user-group --home-dir /var/lib/bench-parts \
            --no-create-home --shell /usr/sbin/nologin bench-parts
    fi
    install -d -o bench-parts -g bench-parts -m 0750 /var/lib/bench-parts

    # Upgrading from before the default moved from 8000 to 8402: keep a set-up
    # install on 8000, so benchhud and bookmarks still reach it. Only when the
    # owner hasn't chosen a port. A fresh install, or one never set up (no
    # settings.env), gets 8402.
    settings=/var/lib/bench-parts/settings.env
    if [ -n "$2" ] && [ -f "$settings" ] \
        && ! grep -q '^[[:space:]]*BENCH_PARTS_PORT=' "$settings"; then
        # Don't glue the new line onto a last line without a newline.
        if [ -s "$settings" ] && [ -n "$(tail -c 1 "$settings")" ]; then
            echo >> "$settings"
        fi
        echo "BENCH_PARTS_PORT=8000" >> "$settings"
    fi
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable bench-parts.service >/dev/null 2>&1 || true
    # Restart on upgrade; on a fresh install there's no password yet, and the
    # service refuses to start without one (by design).
    if [ -n "$2" ]; then
        systemctl try-restart bench-parts.service >/dev/null 2>&1 || true
    fi
fi

if [ -z "$2" ]; then
    cat <<'MSG'

bench-parts is installed. Set a password, then start it:

    sudo bench-parts set-password
    sudo systemctl start bench-parts

It listens on 127.0.0.1:8402. For a tablet, or benchhud on another machine,
add BENCH_PARTS_HOST=0.0.0.0 to /var/lib/bench-parts/settings.env and restart
it. Keep it off public networks.

MSG
fi
exit 0
